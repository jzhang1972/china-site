---
import Layout from "../../layouts/Layout.astro";
---

<Layout 
  title="Outdoor Adventure in China · Yangshuo, Siguniang & Xinjiang" 
  description="Rock climb Yangshuo's karst cliffs, hike the snow peaks of Siguniang, and cross the grasslands of Xinjiang. China's wild side in 15-20 days."
>
  <!-- 返回链接 -->
  <a href="/findway" style="display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem; color: #6c757d; text-decoration: none; font-size: 0.9rem; transition: color 0.3s;">
    <span>←</span> Back to Routes
  </a>

  <!-- ===== 主题标题 ===== -->
  <div style="text-align: center; margin-bottom: 2.5rem;">
    <span style="display: inline-block; background: rgba(196, 158, 58, 0.12); color: #C49E3A; padding: 0.15rem 1rem; border-radius: 20px; font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 0.75rem;">Theme</span>
    <h1 style="font-size: 3.5rem; font-weight: 700; color: #1F2A2E; margin: 0 0 0.3rem 0; letter-spacing: -1px;">Outdoor</h1>
    <p style="font-size: 1.2rem; font-style: italic; color: #6c757d; margin-bottom: 0;">"No ceiling. No walls. Just you and nature."</p>
  </div>

  <!-- ===== 轮播图 ===== -->
  <div id="outdoor-carousel" style="position: relative; overflow: hidden; border-radius: 20px; margin-bottom: 3rem; background: #e8e4dc; box-shadow: 0 4px 24px rgba(0,0,0,0.06);">
    <div id="outdoor-carousel-track" style="display: flex; transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);">

      <!-- 图片1：阳朔攀岩 -->
      <div class="outdoor-slide" style="min-width: 100%; position: relative;">
        <img src="/images/theme/outdoor/outdoor-yangshuo-karst-mountains-river-china.webp" alt="Karst mountains rising from the Li River in Yangshuo, China" loading="eager" style="width: 100%; height: 420px; object-fit: cover; display: block;">
        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);">
          <p style="color: rgba(255,255,255,0.85); font-size: 0.95rem; margin: 0; font-weight: 300;">Yangshuo, karst peaks rising from the misty Li River, and one of the world's best climbing spots</p>
        </div>
      </div>

      <!-- 图片2：四姑娘山 -->
      <div class="outdoor-slide" style="min-width: 100%; position: relative;">
        <img src="/images/theme/outdoor/outdoor-sichuan-siguniang-mountain-snow-peaks-china.webp" alt="Snow-capped Siguniang Mountain peaks in Sichuan, China" loading="eager" style="width: 100%; height: 420px; object-fit: cover; display: block;">
        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);">
          <p style="color: rgba(255,255,255,0.85); font-size: 0.95rem; margin: 0; font-weight: 300;">Siguniang Mountain, the "Four Sisters" of Sichuan and a hiker's gateway to the Tibetan plateau</p>
        </div>
      </div>

      <!-- 图片3：新疆蒙古包 -->
      <div class="outdoor-slide" style="min-width: 100%; position: relative;">
        <img src="/images/theme/outdoor/outdoor-xinjiang-yurt-grassland-mountains-china.webp" alt="Traditional yurt on the grassland with mountain range in Xinjiang, China" loading="eager" style="width: 100%; height: 420px; object-fit: cover; display: block;">
        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);">
          <p style="color: rgba(255,255,255,0.85); font-size: 0.95rem; margin: 0; font-weight: 300;">Xinjiang, where the grassland meets the sky and the yurts never seem to end</p>
        </div>
      </div>

      <!-- 图片4：漓江渔火 -->
      <div class="outdoor-slide" style="min-width: 100%; position: relative;">
        <img src="/images/theme/outdoor/outdoor-guilin-fisherman-cormorant-night-china.webp" alt="Fisherman with cormorant on a bamboo raft at night in Guilin, China" loading="eager" style="width: 100%; height: 420px; object-fit: cover; display: block;">
        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);">
          <p style="color: rgba(255,255,255,0.85); font-size: 0.95rem; margin: 0; font-weight: 300;">Guilin, where fishermen and cormorants still share the river at dusk</p>
        </div>
      </div>

    </div>

    <!-- 箭头 -->
    <button id="outdoor-prev" style="position: absolute; top: 50%; left: 16px; transform: translateY(-50%); background: rgba(255,255,255,0.85); backdrop-filter: blur(4px); color: #1F2A2E; border: none; width: 40px; height: 40px; border-radius: 50%; font-size: 1.3rem; cursor: pointer; z-index: 10; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 12px rgba(0,0,0,0.08); transition: all 0.3s;">‹</button>
    <button id="outdoor-next" style="position: absolute; top: 50%; right: 16px; transform: translateY(-50%); background: rgba(255,255,255,0.85); backdrop-filter: blur(4px); color: #1F2A2E; border: none; width: 40px; height: 40px; border-radius: 50%; font-size: 1.3rem; cursor: pointer; z-index: 10; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 12px rgba(0,0,0,0.08); transition: all 0.3s;">›</button>

    <!-- 圆点 -->
    <div id="outdoor-dots" style="position: absolute; bottom: 64px; left: 0; right: 0; display: flex; justify-content: center; gap: 10px; z-index: 10;">
      <span class="outdoor-dot active" data-index="0" style="width: 10px; height: 10px; border-radius: 50%; background: #FFD700; cursor: pointer; transition: all 0.3s;"></span>
      <span class="outdoor-dot" data-index="1" style="width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.4); cursor: pointer; transition: all 0.3s;"></span>
      <span class="outdoor-dot" data-index="2" style="width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.4); cursor: pointer; transition: all 0.3s;"></span>
      <span class="outdoor-dot" data-index="3" style="width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.4); cursor: pointer; transition: all 0.3s;"></span>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="outdoor-lightbox" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.88); z-index: 1000; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(4px);">
    <img id="outdoor-lightbox-img" src="" alt="Enlarged view" style="max-width: 90%; max-height: 80%; object-fit: contain; border-radius: 12px; box-shadow: 0 30px 80px rgba(0,0,0,0.6);">
    <p id="outdoor-lightbox-caption" style="position: absolute; bottom: 60px; left: 50%; transform: translateX(-50%); color: rgba(255,255,255,0.85); font-size: 0.95rem; background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); padding: 0.4rem 1.5rem; border-radius: 30px; margin: 0; text-align: center; max-width: 80%;"></p>
    <button id="outdoor-lightbox-close" style="position: absolute; top: 24px; right: 32px; background: none; border: none; color: #fff; font-size: 2.5rem; cursor: pointer; opacity: 0.5; transition: opacity 0.3s;">&times;</button>
  </div>

  <!-- ===== 推荐地点 ===== -->
  <div style="margin-bottom: 1.5rem;">
    <span style="display: inline-block; background: #2D6A4F; color: #FFFFFF; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 0.3rem 1.2rem; border-radius: 4px;">RECOMMENDED PLACES</span>
  </div>
  <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; margin-bottom: 3rem;">
    <span style="background: #EDEAE0; color: #1F2A2E; padding: 0.3rem 1rem; border-radius: 20px; font-size: 0.85rem;">Yangshuo</span>
    <span style="background: #EDEAE0; color: #1F2A2E; padding: 0.3rem 1rem; border-radius: 20px; font-size: 0.85rem;">Guilin</span>
    <span style="background: #EDEAE0; color: #1F2A2E; padding: 0.3rem 1rem; border-radius: 20px; font-size: 0.85rem;">Siguniang</span>
    <span style="background: #EDEAE0; color: #1F2A2E; padding: 0.3rem 1rem; border-radius: 20px; font-size: 0.85rem;">Xinjiang</span>
  </div>

  <div style="height: 0.5rem;"></div>

  <!-- ===== FEATURED ROUTE ===== -->
  <div style="margin-bottom: 1.5rem;">
    <span style="display: inline-block; background: #2D6A4F; color: #FFFFFF; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 0.3rem 1.2rem; border-radius: 4px;">FEATURED ROUTE</span>
  </div>

  <!-- ===== 路线标题区 ===== -->
  <div style="margin-bottom: 2rem;">
    <h2 style="font-size: 2.4rem; font-weight: 700; color: #1F2A2E; margin: 0 0 0.3rem 0; letter-spacing: -0.5px;">
      Karst · Snow Peaks · <span style="color: #C49E3A;">Grasslands</span>
    </h2>
    <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
      <p style="font-size: 1.05rem; color: #6c757d; font-style: italic; margin: 0;">"Climb, hike, and ride across China's wildest terrain"</p>
      <span style="background: rgba(196, 158, 58, 0.1); color: #C49E3A; padding: 0.15rem 0.8rem; border-radius: 20px; font-size: 0.75rem; border: 1px solid rgba(196, 158, 58, 0.15);">Yangshuo → Siguniang → Xinjiang · 15–20 days</span>
    </div>
  </div>

  <!-- 简介 -->
  <p style="color: #4a4a4a; line-height: 1.9; font-size: 1.05rem; max-width: 750px; margin-bottom: 2.5rem; border-left: 3px solid #C49E3A; padding-left: 1.5rem;">
    Start on the karst cliffs of Yangshuo, where climbers from around the world come for the limestone. Then move to Siguniang in Sichuan for alpine hiking below snow peaks. Finish in Xinjiang, crossing grasslands, yurts, and the edge of the Taklamakan Desert. Three completely different terrains in one trip.
  </p>

  <!-- ===== 三地 Things to do ===== -->
  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-bottom: 2.5rem;">

    <!-- Yangshuo -->
    <div style="background: #FFFFFF; border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 16px rgba(0,0,0,0.04);">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
        <h3 style="color: #1F2A2E; font-size: 1.1rem; margin: 0; font-weight: 600;">Yangshuo</h3>
        <span style="margin-left: auto; background: #EDEAE0; color: #6c757d; padding: 0.1rem 0.6rem; border-radius: 12px; font-size: 0.65rem; font-weight: 500;">5 spots</span>
      </div>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Yangshuo+Rock+Climbing" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Karst Rock Climbing</a>
            , world-class limestone routes for beginners and pros, with schools in town.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Yulong+River+Bamboo+Rafting+Yangshuo" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Bamboo Raft on Yulong River</a>
            , a quiet float past karst peaks with small dams to slide down.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Ten-mile+Gallery+Yangshuo" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Ten-mile Gallery Cycle</a>
            , a flat ride through rice fields, villages, and karst scenery.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Xianggong+Mountain+Yangshuo" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Xianggong Mountain Sunrise Hike</a>
            , a short climb for the most photographed view of the Li River.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Moon+Hill+Yangshuo" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Moon Hill</a>
            , a short hike to a natural arch with panoramic views over the karst.
          </div>
        </li>
      </ul>
    </div>

    <!-- Siguniang -->
    <div style="background: #FFFFFF; border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 16px rgba(0,0,0,0.04);">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
        <h3 style="color: #1F2A2E; font-size: 1.1rem; margin: 0; font-weight: 600;">Siguniang</h3>
        <span style="margin-left: auto; background: #EDEAE0; color: #6c757d; padding: 0.1rem 0.6rem; border-radius: 12px; font-size: 0.65rem; font-weight: 500;">4 spots</span>
      </div>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Changping+Valley+Siguniang" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Changping Valley Hike</a>
            , the easiest valley trek, with views of Siguniang's snow peaks.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Haizi+Valley+Siguniang" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Haizi Valley</a>
            , a longer alpine hike past glacial lakes and yak pastures.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Shuangqiao+Valley+Siguniang" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Shuangqiao Valley</a>
            , the most accessible valley, with a scenic drive and short walks.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Siguniang+Mountain+Town" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Rongzhag (Siguniang Town)</a>
            , the base town for acclimatization and trailheads.
          </div>
        </li>
      </ul>
    </div>

    <!-- Xinjiang -->
    <div style="background: #FFFFFF; border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 16px rgba(0,0,0,0.04);">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
        <h3 style="color: #1F2A2E; font-size: 1.1rem; margin: 0; font-weight: 600;">Xinjiang</h3>
        <span style="margin-left: auto; background: #EDEAE0; color: #6c757d; padding: 0.1rem 0.6rem; border-radius: 12px; font-size: 0.65rem; font-weight: 500;">5 spots</span>
      </div>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Kashgar+Old+Town+Xinjiang" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Kashgar Old Town</a>
            , maze-like alleys, mud-brick houses, and a bustling Sunday bazaar.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Tianshan+Lake+Xinjiang" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Tianshan Heavenly Lake</a>
            , turquoise water surrounded by snow peaks, two hours from Urumqi.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Taklamakan+Desert+Xinjiang" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Taklamakan Camel Trek</a>
            , China's largest desert, with dunes and Silk Road history.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Nalati+Grassland+Xinjiang" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Nalati Grassland</a>
            , rolling green hills and yurt stays in the Ili Valley.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Karakul+Lake+Xinjiang" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Karakul Lake</a>
            , a high-altitude lake on the Karakoram Highway, surrounded by 7,000m peaks.
          </div>
        </li>
      </ul>
    </div>

  </div>

  <!-- ===== Budget + CTA ===== -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: center; background: #EDEAE0; border-radius: 16px; padding: 1.5rem 2rem;">

    <!-- Budget -->
    <div style="display: flex; align-items: center; gap: 2.5rem; flex-wrap: wrap;">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 1.1rem;">💰</span>
        <span style="color: #6c757d; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">Budget</span>
      </div>
      <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
        <div>
          <div style="color: #6c757d; font-size: 0.7rem;">Budget</div>
          <div style="color: #1F2A2E; font-weight: 600; font-size: 1.1rem;">$28–50 <span style="color: #6c757d; font-weight: 400; font-size: 0.7rem;">/day</span></div>
        </div>
        <div>
          <div style="color: #6c757d; font-size: 0.7rem;">Comfort</div>
          <div style="color: #C49E3A; font-weight: 600; font-size: 1.1rem;">$70–110 <span style="color: #C49E3A; font-weight: 400; font-size: 0.7rem; opacity: 0.6;">/day</span></div>
        </div>
        <div>
          <div style="color: #6c757d; font-size: 0.7rem;">Luxury</div>
          <div style="color: #1F2A2E; font-weight: 600; font-size: 1.1rem;">$165+ <span style="color: #6c757d; font-weight: 400; font-size: 0.7rem;">/day</span></div>
        </div>
      </div>
    </div>

    <!-- CTA 按钮 -->
    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.6rem;">
      <a href="/blog/china-travel-checklist/" style="background: #2D6A4F; color: #FFFFFF; padding: 0.6rem 1.5rem; border-radius: 30px; text-decoration: none; font-weight: 600; font-size: 0.9rem;">
        China Travel Checklist →
      </a>
      <p style="font-size: 0.82rem; color: #6c757d; margin: 0; text-align: right; line-height: 1.5;">
        Not sure whether to book a tour? <a href="/tours/" style="color: #2D6A4F; font-weight: 600; text-decoration: underline;">See how to choose a China tour</a>.
      </p>
    </div>
  </div>

</Layout>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('outdoor-carousel-track');
    if (!track) return;
    const slides = track.querySelectorAll('.outdoor-slide');
    const total = slides.length;
    let current = 0;
    let interval;

    const prevBtn = document.getElementById('outdoor-prev');
    const nextBtn = document.getElementById('outdoor-next');
    const dots = document.querySelectorAll('.outdoor-dot');
    const lightbox = document.getElementById('outdoor-lightbox');
    const lightboxImg = document.getElementById('outdoor-lightbox-img');
    const lightboxCaption = document.getElementById('outdoor-lightbox-caption');
    const closeBtn = document.getElementById('outdoor-lightbox-close');

    function goTo(index) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      current = index;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, i) => {
        dot.style.background = i === current ? '#FFD700' : 'rgba(255,255,255,0.4)';
        dot.style.transform = i === current ? 'scale(1.3)' : 'scale(1)';
      });
    }

    function nextSlide() { goTo(current + 1); }
    function prevSlide() { goTo(current - 1); }

    function startAutoPlay() {
      if (interval) clearInterval(interval);
      interval = setInterval(nextSlide, 5000);
    }

    function stopAutoPlay() {
      if (interval) { clearInterval(interval); interval = null; }
    }

    if (prevBtn) prevBtn.addEventListener('click', () => { stopAutoPlay(); prevSlide(); startAutoPlay(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { stopAutoPlay(); nextSlide(); startAutoPlay(); });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        stopAutoPlay();
        goTo(parseInt(dot.dataset.index));
        startAutoPlay();
      });
    });

    document.querySelectorAll('.outdoor-slide img').forEach((img) => {
      img.addEventListener('click', () => {
        lightboxImg.src = img.src;
        const caption = img.closest('.outdoor-slide').querySelector('p')?.textContent || '';
        lightboxCaption.textContent = caption;
        lightbox.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      });
    });

    function closeLightbox() {
      lightbox.style.display = 'none';
      document.body.style.overflow = '';
    }

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === lightboxImg) {
        closeLightbox();
      }
    });
    closeBtn.addEventListener('click', closeLightbox);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });

    goTo(0);
    startAutoPlay();
  });
</script>
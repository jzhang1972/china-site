---
import Layout from "../../layouts/Layout.astro";
---

<Layout 
  title="Slow Travel in China: Suzhou, Hangzhou & Wuzhen (5-7 Days)" 
  description="A slow travel route through Jiangnan: classical gardens in Suzhou, West Lake in Hangzhou, and canal nights in Wuzhen. Built for travelers who want to slow down."
>
  <!-- 返回链接 -->
  <a href="/findway" style="display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem; color: #6c757d; text-decoration: none; font-size: 0.9rem; transition: color 0.3s;">
    <span>←</span> Back to Routes
  </a>

  <!-- ===== 主题标题 ===== -->
  <div style="text-align: center; margin-bottom: 2.5rem;">
    <span style="display: inline-block; background: rgba(196, 158, 58, 0.12); color: #C49E3A; padding: 0.15rem 1rem; border-radius: 20px; font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 0.75rem;">Theme</span>
    <h1 style="font-size: 3.5rem; font-weight: 700; color: #1F2A2E; margin: 0 0 0.3rem 0; letter-spacing: -1px;">Slow Travel</h1>
    <p style="font-size: 1.2rem; font-style: italic; color: #6c757d; margin-bottom: 0;">"Less rush. More China."</p>
  </div>

  <!-- ===== 轮播图 ===== -->
  <div id="slow-carousel" style="position: relative; overflow: hidden; border-radius: 20px; margin-bottom: 3rem; background: #e8e4dc; box-shadow: 0 4px 24px rgba(0,0,0,0.06);">
    <div id="slow-carousel-track" style="display: flex; transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);">

      <!-- 图片1：苏州园林 -->
      <div class="slow-slide" style="min-width: 100%; position: relative;">
        <img src="/images/theme/slow/slow-suzhou-classical-garden-pavilion-china.webp" alt="Classical Chinese garden with pavilion and pond in Suzhou, China" loading="eager" style="width: 100%; height: 420px; object-fit: cover; display: block;">
        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);">
          <p style="color: rgba(255,255,255,0.85); font-size: 0.95rem; margin: 0; font-weight: 300;">Suzhou, where gardens are poetry written in stone and water</p>
        </div>
      </div>

      <!-- 图片2：杭州西湖 -->
      <div class="slow-slide" style="min-width: 100%; position: relative;">
        <img src="/images/theme/slow/slow-hangzhou-west-lake-sunset-china.webp" alt="West Lake at sunset with pagoda and mountains in Hangzhou, China" loading="eager" style="width: 100%; height: 420px; object-fit: cover; display: block;">
        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);">
          <p style="color: rgba(255,255,255,0.85); font-size: 0.95rem; margin: 0; font-weight: 300;">Hangzhou, a thousand years of poetry, still written on the lake</p>
        </div>
      </div>

      <!-- 图片3：乌镇水乡 -->
      <div class="slow-slide" style="min-width: 100%; position: relative;">
        <img src="/images/theme/slow/slow-wuzhen-water-town-canal-boat-china.webp" alt="Ancient water town with wooden houses and canal boats in Wuzhen, China" loading="eager" style="width: 100%; height: 420px; object-fit: cover; display: block;">
        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);">
          <p style="color: rgba(255,255,255,0.85); font-size: 0.95rem; margin: 0; font-weight: 300;">Wuzhen, life still moves at the pace of a wooden boat</p>
        </div>
      </div>

      <!-- 图片4：龙井茶园 -->
      <div class="slow-slide" style="min-width: 100%; position: relative;">
        <img src="/images/theme/slow/slow-hangzhou-longjing-tea-terraces-china.webp" alt="Terraced tea plantations on the hills of Longjing, Hangzhou, China" loading="eager" style="width: 100%; height: 420px; object-fit: cover; display: block;">
        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);">
          <p style="color: rgba(255,255,255,0.85); font-size: 0.95rem; margin: 0; font-weight: 300;">Longjing, where the best tea in China grows among the mist</p>
        </div>
      </div>

    </div>

    <!-- 箭头 -->
    <button id="slow-prev" style="position: absolute; top: 50%; left: 16px; transform: translateY(-50%); background: rgba(255,255,255,0.85); backdrop-filter: blur(4px); color: #1F2A2E; border: none; width: 40px; height: 40px; border-radius: 50%; font-size: 1.3rem; cursor: pointer; z-index: 10; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 12px rgba(0,0,0,0.08); transition: all 0.3s;">‹</button>
    <button id="slow-next" style="position: absolute; top: 50%; right: 16px; transform: translateY(-50%); background: rgba(255,255,255,0.85); backdrop-filter: blur(4px); color: #1F2A2E; border: none; width: 40px; height: 40px; border-radius: 50%; font-size: 1.3rem; cursor: pointer; z-index: 10; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 12px rgba(0,0,0,0.08); transition: all 0.3s;">›</button>

    <!-- 圆点 -->
    <div id="slow-dots" style="position: absolute; bottom: 64px; left: 0; right: 0; display: flex; justify-content: center; gap: 10px; z-index: 10;">
      <span class="slow-dot active" data-index="0" style="width: 10px; height: 10px; border-radius: 50%; background: #FFD700; cursor: pointer; transition: all 0.3s;"></span>
      <span class="slow-dot" data-index="1" style="width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.4); cursor: pointer; transition: all 0.3s;"></span>
      <span class="slow-dot" data-index="2" style="width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.4); cursor: pointer; transition: all 0.3s;"></span>
      <span class="slow-dot" data-index="3" style="width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.4); cursor: pointer; transition: all 0.3s;"></span>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="slow-lightbox" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.88); z-index: 1000; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(4px);">
    <img id="slow-lightbox-img" src="" alt="Enlarged view" style="max-width: 90%; max-height: 80%; object-fit: contain; border-radius: 12px; box-shadow: 0 30px 80px rgba(0,0,0,0.6);">
    <p id="slow-lightbox-caption" style="position: absolute; bottom: 60px; left: 50%; transform: translateX(-50%); color: rgba(255,255,255,0.85); font-size: 0.95rem; background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); padding: 0.4rem 1.5rem; border-radius: 30px; margin: 0; text-align: center; max-width: 80%;"></p>
    <button id="slow-lightbox-close" style="position: absolute; top: 24px; right: 32px; background: none; border: none; color: #fff; font-size: 2.5rem; cursor: pointer; opacity: 0.5; transition: opacity 0.3s;">&times;</button>
  </div>

  <!-- ===== 推荐城市 ===== -->
  <div style="margin-bottom: 1.5rem;">
    <span style="display: inline-block; background: #2D6A4F; color: #FFFFFF; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 0.3rem 1.2rem; border-radius: 4px;">RECOMMENDED CITIES</span>
  </div>
  <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; margin-bottom: 3rem;">
    <span style="background: #EDEAE0; color: #1F2A2E; padding: 0.3rem 1rem; border-radius: 20px; font-size: 0.85rem;">Suzhou</span>
    <span style="background: #EDEAE0; color: #1F2A2E; padding: 0.3rem 1rem; border-radius: 20px; font-size: 0.85rem;">Hangzhou</span>
    <span style="background: #EDEAE0; color: #1F2A2E; padding: 0.3rem 1rem; border-radius: 20px; font-size: 0.85rem;">Wuzhen</span>
  </div>

  <div style="height: 0.5rem;"></div>

  <!-- ===== FEATURED ROUTE ===== -->
  <div style="margin-bottom: 1.5rem;">
    <span style="display: inline-block; background: #2D6A4F; color: #FFFFFF; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 0.3rem 1.2rem; border-radius: 4px;">FEATURED ROUTE</span>
  </div>

  <!-- ===== 路线标题区 ===== -->
  <div style="margin-bottom: 2rem;">
    <h2 style="font-size: 2.4rem; font-weight: 700; color: #1F2A2E; margin: 0 0 0.3rem 0; letter-spacing: -0.5px;">
      Water Towns · Tea · <span style="color: #C49E3A;">Gardens</span>
    </h2>
    <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
      <p style="font-size: 1.05rem; color: #6c757d; font-style: italic; margin: 0;">China at walking pace</p>
      <span style="background: rgba(196, 158, 58, 0.1); color: #C49E3A; padding: 0.15rem 0.8rem; border-radius: 20px; font-size: 0.75rem; border: 1px solid rgba(196, 158, 58, 0.15);">Suzhou → Hangzhou → Wuzhen · 5–7 days</span>
    </div>
  </div>

  <!-- 简介 -->
  <p style="color: #4a4a4a; line-height: 1.9; font-size: 1.05rem; max-width: 750px; margin-bottom: 2.5rem; border-left: 3px solid #C49E3A; padding-left: 1.5rem;">
    Tea plantations, ancient canals, and gardens built for contemplation. This 5 to 7 day route covers Suzhou, Hangzhou, and Wuzhen at a pace that leaves room to actually look.
  </p>

  <!-- ===== 三城 Things to do ===== -->
  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-bottom: 2.5rem;">

    <!-- 苏州 -->
    <div style="background: #FFFFFF; border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 16px rgba(0,0,0,0.04);">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
        <h3 style="color: #1F2A2E; font-size: 1.1rem; margin: 0; font-weight: 600;">Suzhou</h3>
        <span style="margin-left: auto; background: #EDEAE0; color: #6c757d; padding: 0.1rem 0.6rem; border-radius: 12px; font-size: 0.65rem; font-weight: 500;">5 spots</span>
      </div>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Humble+Administrator+Garden+Suzhou" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Humble Administrator's Garden</a>
            , China's finest classical garden. Give it 2 hours to wander.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Pingjiang+Road+Suzhou" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Pingjiang Road</a>
            , a canal-side street of teahouses, bookshops, and quiet corners.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Suzhou+Silk+Museum" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Silk Museum</a>
            , learn how this city became the silk capital of the world.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Suzhou+Canal+Cruise" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Canal boat ride</a>
            , glide through the old city on a wooden boat.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Tiger+Hill+Suzhou" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Tiger Hill</a>
            , a quiet hill with a leaning pagoda and centuries of stories.
          </div>
        </li>
      </ul>
    </div>

    <!-- 杭州 -->
    <div style="background: #FFFFFF; border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 16px rgba(0,0,0,0.04);">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
        <h3 style="color: #1F2A2E; font-size: 1.1rem; margin: 0; font-weight: 600;">Hangzhou</h3>
        <span style="margin-left: auto; background: #EDEAE0; color: #6c757d; padding: 0.1rem 0.6rem; border-radius: 12px; font-size: 0.65rem; font-weight: 500;">5 spots</span>
      </div>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=West+Lake+Hangzhou" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">West Lake</a>
            , walk the shore, hire a boat, or just sit on a bench. No wrong way.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Longjing+Tea+Village+Hangzhou" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Longjing tea village</a>
            , walk through the tea terraces and sip Dragon Well tea at a farmhouse.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Guo%27s+Villa+Hangzhou" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Guo's Villa</a>
            , a hidden garden mansion with views over West Lake.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Jiuxi+Smoke+Tree+Hangzhou" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Jiuxi walking trail</a>
            , a stream-side path through bamboo forests and tea fields.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Grand+Canal+Hangzhou" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Grand Canal night walk</a>
            , the oldest canal in the world, lit up after dark.
          </div>
        </li>
      </ul>
    </div>

    <!-- 乌镇 -->
    <div style="background: #FFFFFF; border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 16px rgba(0,0,0,0.04);">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
        <h3 style="color: #1F2A2E; font-size: 1.1rem; margin: 0; font-weight: 600;">Wuzhen</h3>
        <span style="margin-left: auto; background: #EDEAE0; color: #6c757d; padding: 0.1rem 0.6rem; border-radius: 12px; font-size: 0.65rem; font-weight: 500;">4 spots</span>
      </div>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Wuzhen+Water+Town" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Old town canals</a>
            , stone bridges, wooden houses, and boats gliding through morning mist.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Wuzhen+Homes" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Stay in a canal-side homestay</a>
            , sleep above the water. Wake up to the sound of oars.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Wuzhen+Tea+House" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Morning tea at a waterside teahouse</a>
            , sit by the window and watch the town wake up.
          </div>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start; color: #4a4a4a; font-size: 0.9rem; line-height: 1.5;">
          <span style="color: #C49E3A; font-size: 0.8rem; margin-top: 0.1rem; flex-shrink: 0;">▸</span>
          <div>
            <a href="https://www.google.com/maps/search/?api=1&query=Wuzhen+Evening" target="_blank" rel="noopener noreferrer nofollow" style="color: #C49E3A; font-weight: 600; text-decoration: none;">Evening boat ride</a>
            , lanterns reflected in the water. The quietest time of day.
          </div>
        </li>
      </ul>
    </div>

  </div>

  <!-- ===== Budget + CTA ===== -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: center; background: #EDEAE0; border-radius: 16px; padding: 1.5rem 2rem;">

    <!-- Budget -->
    <div style="display: flex; align-items: center; gap: 2.5rem; flex-wrap: wrap;">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 1.1rem;">💰</span>
        <span style="color: #6c757d; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">Budget</span>
      </div>
      <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
        <div>
          <div style="color: #6c757d; font-size: 0.7rem;">Budget</div>
          <div style="color: #1F2A2E; font-weight: 600; font-size: 1.1rem;">$28–50 <span style="color: #6c757d; font-weight: 400; font-size: 0.7rem;">/day</span></div>
        </div>
        <div>
          <div style="color: #6c757d; font-size: 0.7rem;">Comfort</div>
          <div style="color: #C49E3A; font-weight: 600; font-size: 1.1rem;">$70–110 <span style="color: #C49E3A; font-weight: 400; font-size: 0.7rem; opacity: 0.6;">/day</span></div>
        </div>
        <div>
          <div style="color: #6c757d; font-size: 0.7rem;">Luxury</div>
          <div style="color: #1F2A2E; font-weight: 600; font-size: 1.1rem;">$165+ <span style="color: #6c757d; font-weight: 400; font-size: 0.7rem;">/day</span></div>
        </div>
      </div>
    </div>

    <!-- CTA 按钮 -->
    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.6rem;">
      <a href="/blog/china-travel-checklist/" style="background: #2D6A4F; color: #FFFFFF; padding: 0.6rem 1.5rem; border-radius: 30px; text-decoration: none; font-weight: 600; font-size: 0.9rem;">
        China Travel Checklist →
      </a>
      <p style="font-size: 0.82rem; color: #6c757d; margin: 0; text-align: right; line-height: 1.5;">
        Not sure whether to book a tour? <a href="/tours/" style="color: #2D6A4F; font-weight: 600; text-decoration: underline;">See how to choose a China tour</a>.
      </p>
    </div>
  </div>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('slow-carousel-track');
    if (!track) return;
    const slides = track.querySelectorAll('.slow-slide');
    const total = slides.length;
    let current = 0;
    let interval;

    const prevBtn = document.getElementById('slow-prev');
    const nextBtn = document.getElementById('slow-next');
    const dots = document.querySelectorAll('.slow-dot');
    const lightbox = document.getElementById('slow-lightbox');
    const lightboxImg = document.getElementById('slow-lightbox-img');
    const lightboxCaption = document.getElementById('slow-lightbox-caption');
    const closeBtn = document.getElementById('slow-lightbox-close');

    function goTo(index) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      current = index;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, i) => {
        dot.style.background = i === current ? '#FFD700' : 'rgba(255,255,255,0.4)';
        dot.style.transform = i === current ? 'scale(1.3)' : 'scale(1)';
      });
    }

    function nextSlide() { goTo(current + 1); }
    function prevSlide() { goTo(current - 1); }

    function startAutoPlay() {
      if (interval) clearInterval(interval);
      interval = setInterval(nextSlide, 5000);
    }

    function stopAutoPlay() {
      if (interval) { clearInterval(interval); interval = null; }
    }

    if (prevBtn) prevBtn.addEventListener('click', () => { stopAutoPlay(); prevSlide(); startAutoPlay(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { stopAutoPlay(); nextSlide(); startAutoPlay(); });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        stopAutoPlay();
        goTo(parseInt(dot.dataset.index));
        startAutoPlay();
      });
    });

    document.querySelectorAll('.slow-slide img').forEach((img) => {
      img.addEventListener('click', () => {
        lightboxImg.src = img.src;
        const caption = img.closest('.slow-slide').querySelector('p')?.textContent || '';
        lightboxCaption.textContent = caption;
        lightbox.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      });
    });

    function closeLightbox() {
      lightbox.style.display = 'none';
      document.body.style.overflow = '';
    }

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === lightboxImg) {
        closeLightbox();
      }
    });
    closeBtn.addEventListener('click', closeLightbox);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });

    goTo(0);
    startAutoPlay();
  });
</script>


---
// src/components/HeroCarousel.astro
---

<div id="hero-carousel" style="position: relative; overflow: hidden; width: 100%; background: #1a1a1a; height: 80vh; min-height: 400px; max-height: 700px;">
  <div id="hero-carousel-track" style="display: flex; transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94); height: 100%;">
    
    <!-- 1. 重庆夜景 -->
    <div class="hero-slide" style="min-width: 100%; height: 100%; position: relative;">
      <img 
        src="/images/hero/chongqing-china-cyberpunk-night.webp" 
        alt="Chongqing cyberpunk skyline at night with neon lights and Hongyadong stilt houses" 
        fetchpriority="high" 
        loading="eager" 
        style="width: 100%; height: 100%; object-fit: cover; display: block;">
      
      <!-- 把底部的 div 换成 a，整体变成超大点击区 -->
      <a href="/blog/chongqing-travel-guide/" class="hero-link" style="position: absolute; bottom: 0; left: 0; right: 0; padding: 4rem 2rem 3rem 2rem; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%); display: flex; flex-direction: column; align-items: flex-start; text-decoration: none;">
        <div class="hero-content">
          <h2 style="color: #FFFFFF; font-size: 1.8rem; font-weight: 700; margin: 0 0 0.5rem 0;">Chongqing: The 8D Cyberpunk City</h2>
          <p style="color: rgba(255,255,255,0.85); font-size: 1rem; margin: 0 0 0.8rem 0; font-weight: 300;">Where neon meets ancient stilt houses.</p>
          <span class="hero-btn" style="color: #FFD700; font-weight: 600; font-size: 0.95rem; border-bottom: 2px solid #FFD700; padding-bottom: 2px;">Read the Chongqing Guide →</span>
        </div>
      </a>
    </div>
    
    <!-- 2. 巴国宴 -->
    <div class="hero-slide" style="min-width: 100%; height: 100%; position: relative;">
      <img 
        src="/images/hero/chongqing-china-ba-kingdom-banquet.webp" 
        alt="Traditional Ba Kingdom royal banquet performance in Chongqing China" 
        loading="lazy" 
        style="width: 100%; height: 100%; object-fit: cover; display: block;">
      
      <a href="/blog/china-chongqing-banquet-ba-kingdom/" class="hero-link" style="position: absolute; bottom: 0; left: 0; right: 0; padding: 4rem 2rem 3rem 2rem; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%); display: flex; flex-direction: column; align-items: flex-start; text-decoration: none;">
        <div class="hero-content">
          <h2 style="color: #FFFFFF; font-size: 1.8rem; font-weight: 700; margin: 0 0 0.5rem 0;">Step into a 3,000-Year-Old Royal Feast</h2>
          <p style="color: rgba(255,255,255,0.85); font-size: 1rem; margin: 0 0 0.8rem 0; font-weight: 300;">Discover the hidden Ba Kingdom Banquet.</p>
          <span class="hero-btn" style="color: #FFD700; font-weight: 600; font-size: 0.95rem; border-bottom: 2px solid #FFD700; padding-bottom: 2px;">Read the Banquet Guide →</span>
        </div>
      </a>
    </div>
    
    <!-- 3. 桂林漓江 -->
    <div class="hero-slide" style="min-width: 100%; height: 100%; position: relative;">
      <img 
        src="/images/hero/guilin-china-li-river-landscape.webp" 
        alt="Karst mountains and the Li River in Guilin China" 
        loading="lazy" 
        style="width: 100%; height: 100%; object-fit: cover; display: block;">
      
      <a href="/blog/guilin-li-river/" class="hero-link" style="position: absolute; bottom: 0; left: 0; right: 0; padding: 4rem 2rem 3rem 2rem; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%); display: flex; flex-direction: column; align-items: flex-start; text-decoration: none;">
        <div class="hero-content">
          <h2 style="color: #FFFFFF; font-size: 1.8rem; font-weight: 700; margin: 0 0 0.5rem 0;">Guilin: The Soul of Chinese Landscapes</h2>
          <p style="color: rgba(255,255,255,0.85); font-size: 1rem; margin: 0 0 0.8rem 0; font-weight: 300;">The scenery that inspired a thousand years of art.</p>
          <span class="hero-btn" style="color: #FFD700; font-weight: 600; font-size: 0.95rem; border-bottom: 2px solid #FFD700; padding-bottom: 2px;">Read the Guilin Guide →</span>
        </div>
      </a>
    </div>
    
    <!-- 4. 高铁 -->
    <div class="hero-slide" style="min-width: 100%; height: 100%; position: relative;">
      <img 
        src="/images/hero/china-high-speed-train-350kmh.webp" 
        alt="A high-speed train traveling through China at 350 km/h" 
        loading="lazy" 
        style="width: 100%; height: 100%; object-fit: cover; display: block;">
      
      <a href="/blog/book-high-speed-train-tickets-china-foreigners/" class="hero-link" style="position: absolute; bottom: 0; left: 0; right: 0; padding: 4rem 2rem 3rem 2rem; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%); display: flex; flex-direction: column; align-items: flex-start; text-decoration: none;">
        <div class="hero-content">
          <h2 style="color: #FFFFFF; font-size: 1.8rem; font-weight: 700; margin: 0 0 0.5rem 0;">Cross China at 350 km/h</h2>
          <p style="color: rgba(255,255,255,0.85); font-size: 1rem; margin: 0 0 0.8rem 0; font-weight: 300;">How to book and board China's high-speed trains.</p>
          <span class="hero-btn" style="color: #FFD700; font-weight: 600; font-size: 0.95rem; border-bottom: 2px solid #FFD700; padding-bottom: 2px;">Read the Train Guide →</span>
        </div>
      </a>
    </div>
    
    <!-- 5. 扫码支付 -->
    <div class="hero-slide" style="min-width: 100%; height: 100%; position: relative;">
      <img 
        src="/images/hero/china-tourist-qr-code-payment.webp" 
        alt="Foreign tourist scanning Alipay QR code payment in China" 
        loading="lazy" 
        style="width: 100%; height: 100%; object-fit: cover; display: block;">
      
      <a href="/blog/how-to-pay-in-china/" class="hero-link" style="position: absolute; bottom: 0; left: 0; right: 0; padding: 4rem 2rem 3rem 2rem; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%); display: flex; flex-direction: column; align-items: flex-start; text-decoration: none;">
        <div class="hero-content">
          <h2 style="color: #FFFFFF; font-size: 1.8rem; font-weight: 700; margin: 0 0 0.5rem 0;">Cashless China: Pay Like a Local</h2>
          <p style="color: rgba(255,255,255,0.85); font-size: 1rem; margin: 0 0 0.8rem 0; font-weight: 300;">Set up Alipay and WeChat Pay before you land.</p>
          <span class="hero-btn" style="color: #FFD700; font-weight: 600; font-size: 0.95rem; border-bottom: 2px solid #FFD700; padding-bottom: 2px;">Read the Payment Guide →</span>
        </div>
      </a>
    </div>
    
  </div>
  
  <!-- 左右箭头 -->
  <button id="hero-prev" aria-label="Previous slide" style="position: absolute; top: 50%; left: 16px; transform: translateY(-50%); background: rgba(0,0,0,0.4); color: white; border: none; width: 44px; height: 44px; border-radius: 50%; font-size: 1.5rem; cursor: pointer; z-index: 10; display: flex; align-items: center; justify-content: center; transition: background 0.2s;">‹</button>
  <button id="hero-next" aria-label="Next slide" style="position: absolute; top: 50%; right: 16px; transform: translateY(-50%); background: rgba(0,0,0,0.4); color: white; border: none; width: 44px; height: 44px; border-radius: 50%; font-size: 1.5rem; cursor: pointer; z-index: 10; display: flex; align-items: center; justify-content: center; transition: background 0.2s;">›</button>
  
  <!-- 圆点指示器 -->
  <div id="hero-dots" style="position: absolute; bottom: 80px; left: 0; right: 0; display: flex; justify-content: center; gap: 10px; z-index: 10;">
    <span class="hero-dot active" data-index="0" style="width: 10px; height: 10px; border-radius: 50%; background: #FFD700; cursor: pointer; transition: all 0.3s;"></span>
    <span class="hero-dot" data-index="1" style="width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.4); cursor: pointer; transition: all 0.3s;"></span>
    <span class="hero-dot" data-index="2" style="width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.4); cursor: pointer; transition: all 0.3s;"></span>
    <span class="hero-dot" data-index="3" style="width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.4); cursor: pointer; transition: all 0.3s;"></span>
    <span class="hero-dot" data-index="4" style="width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.4); cursor: pointer; transition: all 0.3s;"></span>
  </div>


</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('hero-carousel-track');
    const slides = track.querySelectorAll('.hero-slide');
    const total = slides.length;
    let current = 0;
    let interval;

    const prevBtn = document.getElementById('hero-prev');
    const nextBtn = document.getElementById('hero-next');
    const dots = document.querySelectorAll('.hero-dot');

    function goTo(index) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      current = index;
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      dots.forEach(function(dot, i) {
        dot.style.background = i === current ? '#FFD700' : 'rgba(255,255,255,0.4)';
        dot.style.transform = i === current ? 'scale(1.3)' : 'scale(1)';
      });
    }

    function nextSlide() { goTo(current + 1); }
    function prevSlide() { goTo(current - 1); }

    function startAutoPlay() {
      if (interval) clearInterval(interval);
      interval = setInterval(nextSlide, 5000);
    }

    function stopAutoPlay() {
      if (interval) { clearInterval(interval); interval = null; }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() { stopAutoPlay(); prevSlide(); startAutoPlay(); });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function() { stopAutoPlay(); nextSlide(); startAutoPlay(); });
    }

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        stopAutoPlay();
        goTo(parseInt(this.dataset.index));
        startAutoPlay();
      });
    });

    startAutoPlay();
  });
</script>

<style is:global>
  #hero-carousel button:hover {
    background: rgba(255,255,255,0.2) !important;
    color: #FFD700 !important;
  }
  
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  /* 底部超大点击区的悬停效果 */
  .hero-content {
    transition: transform 0.3s ease;
  }
  
  .hero-btn {
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  /* 鼠标悬停时：文字整体微微上浮 4px */
  a.hero-link:hover .hero-content {
    transform: translateY(-4px);
  }
  
  /* 鼠标悬停时：Read the Guide 文字和下划线变白 */
  a.hero-link:hover .hero-btn {
    color: #FFFFFF !important;
    border-bottom-color: #FFFFFF !important;
  }

  /* 手机端适配 */
  @media (max-width: 768px) {
    #hero-carousel {
      height: 50vh !important; 
    }
    #hero-carousel h2 {
      font-size: 1.3rem !important;
    }
    #hero-carousel p {
      font-size: 0.85rem !important;
    }
    #hero-carousel .hero-slide > a {
      padding: 2rem 1rem 1.5rem 1rem !important;
    }
    #hero-dots {
      bottom: 40px !important;
    }
  }
</style>